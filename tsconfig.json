{
    "compilerOptions": {
        "target": "ES2020",
        "module": "Node16",
        "moduleResolution": "Node16",
        "outDir": "dist/js",
        "rootDir": "src/ts",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "types": ["node"],
        "sourceMap": true,
        "skipLibCheck": true
    },
    "include": ["src/ts/**/*"],
    "exclude": ["node_modules", "dist"]
}